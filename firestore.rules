rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ================================
    // PRODUCTS
    // ================================
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ================================
    // CATEGORIES
    // ================================
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ================================
    // COLLECTIONS
    // ================================
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ================================
    // USERS
    // ================================
    match /users/{userId} {

      // User can read/write only his own profile
      allow read, write: if
        request.auth != null &&
        request.auth.uid == userId;

      // ==============================
      // USER CART
      // ==============================
      match /cart/{cartId} {
        allow read, write: if
          request.auth != null &&
          request.auth.uid == userId;
      }

      // ==============================
      // USER WISHLIST
      // ==============================
      match /wishlist/{wishlistId} {
        allow read, write: if
          request.auth != null &&
          request.auth.uid == userId;
      }

      // ==============================
      // USER ORDERS
      // ==============================
      match /orders/{orderId} {
        allow read, write: if
          request.auth != null &&
          request.auth.uid == userId;
      }

      // ==============================
      // USER ADDRESSES
      // ==============================
      match /addresses/{addressId} {
        allow read, write: if
          request.auth != null &&
          request.auth.uid == userId;
      }
    }
  }
}